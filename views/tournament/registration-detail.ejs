<div class="container my-5">
  <a href="/my-tournaments" class="text-decoration-none small text-muted"><i class="fa-solid fa-arrow-left me-1"></i>My tournaments</a>

  <div class="row g-4 mt-1">
    <div class="col-lg-7">
      <div class="card p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <h4 class="mb-1"><%= team.name %></h4>
            <p class="text-muted mb-0">
              <%= team.Tournament ? team.Tournament.name : 'Tournament' %>
              <% if (team.Tournament) { %> &middot; <%= team.Tournament.sport %> &middot; <%= team.Tournament.teamSize %>-a-side<% } %>
            </p>
          </div>
          <span class="badge bg-<%= team.status==='confirmed'?'success':team.status==='pending'?'warning':'danger' %> fs-6"><%= team.status %></span>
        </div>

        <% if (team.status === 'pending') { %>
          <div class="alert alert-warning py-2 small mb-3">
            <i class="fa-solid fa-hourglass-half me-1"></i>
            Your entry fee is awaiting verification by the organiser. Your spot is held in the meantime.
          </div>
        <% } else if (team.status === 'confirmed') { %>
          <div class="alert alert-success py-2 small mb-3">
            <i class="fa-solid fa-circle-check me-1"></i>
            Your team is confirmed. Show the QR code at the venue on match day.
          </div>
        <% } else if (team.status === 'rejected') { %>
          <div class="alert alert-danger py-2 small mb-3">
            <i class="fa-solid fa-circle-xmark me-1"></i>
            The organiser could not verify your entry fee payment. Please re-submit the correct payment details below.
          </div>
        <% } else if (team.status === 'withdrawn') { %>
          <div class="alert alert-secondary py-2 small mb-3">This team has been withdrawn from the tournament.</div>
        <% } %>

        <table class="table table-sm">
          <tbody>
            <tr><th style="width:40%">Registration Ref</th><td class="fw-bold"><%= team.regRef %></td></tr>
            <tr><th>Captain</th><td><%= team.captainName %></td></tr>
            <tr><th>Phone</th><td><%= team.captainPhone %></td></tr>
            <% if (team.captainEmail) { %><tr><th>Email</th><td><%= team.captainEmail %></td></tr><% } %>
            <% if (team.Tournament) { %>
              <tr><th>Dates</th><td><%= team.Tournament.startDate %> to <%= team.Tournament.endDate %></td></tr>
              <% if (team.Tournament.venue) { %><tr><th>Venue</th><td><%= team.Tournament.venue %></td></tr><% } %>
            <% } %>
            <tr><th>Entry Fee</th><td><%= team.entryFeeAmount > 0 ? '৳' + team.entryFeeAmount : 'Free' %></td></tr>
            <% if (team.notes) { %><tr><th>Notes</th><td><%= team.notes %></td></tr><% } %>
          </tbody>
        </table>

        <h6 class="mt-3">Players (<%= players.length %>)</h6>
        <% if (players.length === 0) { %>
          <p class="text-muted small">No players listed.</p>
        <% } else { %>
          <ol class="mb-0"><% players.forEach(p => { %><li><%= p %></li><% }) %></ol>
        <% } %>
      </div>

      <!-- ---------------- Entry fee / invoice ---------------- -->
      <% if (team.Payment) { %>
        <div class="card p-4 shadow-sm mt-4">
          <h5 class="mb-3">Entry Fee Payment</h5>
          <table class="table table-sm">
            <tbody>
              <tr><th style="width:40%">Invoice No</th><td><%= team.Payment.invoiceNo %></td></tr>
              <tr><th>Method</th><td><%= team.Payment.method %></td></tr>
              <tr><th>Amount</th><td class="fw-bold">৳<%= team.Payment.amount %></td></tr>
              <tr><th>Transaction ID</th><td><%= team.Payment.transactionId || '-' %></td></tr>
              <tr><th>Payer</th><td><%= team.Payment.payerName || '-' %> (<%= team.Payment.payerNumber || '-' %>)</td></tr>
              <tr>
                <th>Status</th>
                <td><span class="badge bg-<%= team.Payment.status==='paid'?'success':team.Payment.status==='pending'?'warning':'danger' %>"><%= team.Payment.status %></span></td>
              </tr>
            </tbody>
          </table>

          <% if (team.status !== 'confirmed' && team.status !== 'withdrawn') { %>
            <hr>
            <h6>Update Payment Details</h6>
            <p class="small text-muted">
              Paid to <strong><%= settings.contactPhone %></strong>? Enter the transaction details so the organiser can verify it.
            </p>
            <form method="POST" action="/my-tournaments/<%= team.id %>/payment">
              <div class="row g-2">
                <div class="col-md-6 mb-2">
                  <label class="form-label small mb-1">Method</label>
                  <select name="method" class="form-select">
                    <% ['bKash','Nagad','Rocket','Card','Cash'].forEach(m => { %>
                      <option value="<%= m %>" <%= team.Payment.method === m ? 'selected' : '' %>><%= m %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-md-6 mb-2">
                  <label class="form-label small mb-1">Transaction ID</label>
                  <input name="transactionId" class="form-control" value="<%= team.Payment.transactionId || '' %>" required>
                </div>
                <div class="col-md-6 mb-2">
                  <label class="form-label small mb-1">Payer Name</label>
                  <input name="payerName" class="form-control" value="<%= team.Payment.payerName || '' %>" required>
                </div>
                <div class="col-md-6 mb-2">
                  <label class="form-label small mb-1">Payer Number</label>
                  <input name="payerNumber" class="form-control" value="<%= team.Payment.payerNumber || '' %>" required>
                </div>
              </div>
              <button class="btn btn-success w-100 mt-2">Submit Payment Details</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- ---------------- Right: QR + actions ---------------- -->
    <div class="col-lg-5">
      <div class="card p-4 shadow-sm text-center">
        <h6 class="text-muted">Entry Pass</h6>
        <% if (team.qrCode) { %>
          <img src="<%= team.qrCode %>" alt="Registration QR" class="img-fluid mx-auto" style="max-width: 220px;">
        <% } else { %>
          <p class="text-muted small">QR code unavailable.</p>
        <% } %>
        <p class="fw-bold mt-2 mb-0"><%= team.regRef %></p>
        <p class="small text-muted">
          <%= team.status === 'confirmed' ? 'Show this at the venue on match day.' : 'Valid once your registration is confirmed.' %>
        </p>

        <div class="d-grid gap-2 mt-3">
          <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-print me-1"></i>Print</button>
          <% if (team.Tournament) { %>
            <a href="/tournaments/<%= team.Tournament.id %>" class="btn btn-outline-success btn-sm">View Tournament</a>
          <% } %>
          <% if (team.status === 'pending' || team.status === 'confirmed') { %>
            <form action="/my-tournaments/<%= team.id %>/withdraw" method="POST" onsubmit="return confirm('Withdraw this team from the tournament?')">
              <button class="btn btn-outline-danger btn-sm w-100">Withdraw Team</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
