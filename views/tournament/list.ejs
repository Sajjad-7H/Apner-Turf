<div class="container my-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <h2 class="mb-1">Tournaments</h2>
      <p class="text-muted mb-0">Register your team, pay the entry fee and get on the fixture list.</p>
    </div>
    <% if (currentUser && currentUser.role !== 'admin') { %>
      <a href="/my-tournaments" class="btn btn-outline-success"><i class="fa-solid fa-people-group me-1"></i> My Tournaments</a>
    <% } %>
  </div>

  <form method="GET" action="/tournaments" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
      <label class="form-label small mb-1">Sport</label>
      <select name="sport" class="form-select form-select-sm" onchange="this.form.submit()">
        <% ['All','Football','Cricket'].forEach(s => { %>
          <option value="<%= s %>" <%= selectedSport === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-auto">
      <label class="form-label small mb-1">Status</label>
      <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
        <% ['All','upcoming','ongoing','completed','cancelled'].forEach(s => { %>
          <option value="<%= s %>" <%= selectedStatus === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-auto"><button class="btn btn-sm btn-success">Filter</button></div>
  </form>

  <div class="row g-4">
    <% if (rows.length === 0) { %>
      <div class="col-12"><p class="text-muted">No tournaments match your filter.</p></div>
    <% } %>
    <% rows.forEach(({ t, reg }) => { %>
      <div class="col-md-4">
        <div class="card p-0 h-100 overflow-hidden shadow-sm">
          <div class="position-relative">
            <% if (t.image) { %>
              <img src="<%= t.image %>" alt="<%= t.name %>" class="card-img-top" style="height: 180px; object-fit: cover;">
            <% } else { %>
              <div style="height: 180px; background-color: #e9ecef; display: flex; align-items: center; justify-content: center;">
                <span class="text-muted">No Image</span>
              </div>
            <% } %>
            <span class="badge bg-<%= t.status==='upcoming'?'success':t.status==='ongoing'?'warning':t.status==='cancelled'?'danger':'secondary' %> position-absolute top-0 end-0 m-2"><%= t.status %></span>
          </div>
          <div class="card-body d-flex flex-column">
            <h5 class="card-title mb-1"><%= t.name %></h5>
            <p class="text-muted small mb-2">
              <i class="fa-solid fa-futbol me-1"></i><%= t.sport %> &middot; <%= t.teamSize %>-a-side
              <% if (t.venue) { %><br><i class="fa-solid fa-location-dot me-1"></i><%= t.venue %><% } %>
            </p>
            <p class="mb-1 small"><i class="fa-regular fa-calendar me-1"></i><%= t.startDate %> to <%= t.endDate %></p>
            <% if (t.registrationDeadline) { %>
              <p class="mb-1 small text-danger"><i class="fa-regular fa-clock me-1"></i>Register by <%= t.registrationDeadline %></p>
            <% } %>

            <div class="d-flex justify-content-between align-items-center my-2">
              <span class="fw-bold text-success">Entry: <%= t.entryFee > 0 ? '৳' + t.entryFee : 'Free' %></span>
              <% if (t.prizeMoney > 0) { %><span class="badge bg-warning text-dark"><i class="fa-solid fa-trophy me-1"></i>৳<%= t.prizeMoney %></span><% } %>
            </div>

            <% const filled = t.maxTeams - reg.spotsLeft; %>
            <div class="progress mb-1" style="height: 6px;">
              <div class="progress-bar bg-success" style="width: <%= Math.min(100, Math.round(filled / t.maxTeams * 100)) %>%"></div>
            </div>
            <p class="small text-muted mb-3"><%= filled %> / <%= t.maxTeams %> teams registered<%= reg.open ? ` — ${reg.spotsLeft} spot${reg.spotsLeft === 1 ? '' : 's'} left` : '' %></p>

            <a href="/tournaments/<%= t.id %>" class="btn btn-<%= reg.open ? 'success' : 'outline-secondary' %> btn-sm mt-auto">
              <%= reg.open ? 'View & Register' : 'View Details' %>
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>
