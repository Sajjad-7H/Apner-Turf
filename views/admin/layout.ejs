<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Admin - <%= settings.siteName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="d-flex">
  <div class="sidebar text-white p-3" style="width:240px;">
    <h5 class="mb-4"><i class="fa-solid fa-futbol"></i> <%= settings.siteName %></h5>
    <nav class="nav flex-column gap-1">
      <a class="nav-link" href="/admin/dashboard"><i class="fa-solid fa-gauge me-2"></i>Dashboard</a>
      <a class="nav-link" href="/admin/turfs"><i class="fa-solid fa-map me-2"></i>Turfs</a>
      <a class="nav-link" href="/admin/bookings"><i class="fa-solid fa-calendar-check me-2"></i>Bookings</a>
      <a class="nav-link" href="/admin/slots"><i class="fa-solid fa-calendar-days me-2"></i>Slot Availability</a>
      <a class="nav-link" href="/admin/users"><i class="fa-solid fa-users me-2"></i>Users</a>
      <a class="nav-link" href="/admin/payments"><i class="fa-solid fa-money-bill me-2"></i>Payments</a>
      <a class="nav-link" href="/admin/reviews"><i class="fa-solid fa-star me-2"></i>Reviews</a>
      <a class="nav-link" href="/admin/coupons"><i class="fa-solid fa-tag me-2"></i>Coupons/Offers</a>
      <a class="nav-link" href="/admin/tournaments"><i class="fa-solid fa-trophy me-2"></i>Tournaments</a>
      <a class="nav-link" href="/admin/reports"><i class="fa-solid fa-chart-line me-2"></i>Reports</a>
      <a class="nav-link" href="/admin/settings"><i class="fa-solid fa-gear me-2"></i>Site Settings</a>
      <hr class="border-secondary">
      <a class="nav-link" href="/"><i class="fa-solid fa-house me-2"></i>Visit Site</a>
      <a class="nav-link" href="/logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Logout</a>
    </nav>
  </div>
  <div class="flex-fill">
    <div class="p-4">
      <% if (success && success.length) { %>
        <% success.forEach(msg => { %><div class="alert alert-success alert-dismissible fade show"><%= msg %><button class="btn-close" data-bs-dismiss="alert"></button></div><% }) %>
      <% } %>
      <% if (error && error.length) { %>
        <% error.forEach(msg => { %><div class="alert alert-danger alert-dismissible fade show"><%= msg %><button class="btn-close" data-bs-dismiss="alert"></button></div><% }) %>
      <% } %>
      <h3 class="mb-4"><%= title %></h3>
      <%- body %>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
