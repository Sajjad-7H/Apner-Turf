<section class="hero text-center">
  <div class="container">
    <h1 class="display-5 fw-bold"><%= settings.siteName %></h1>
    <p class="lead"><%= settings.tagline %></p>
    <a href="/turfs" class="btn btn-light btn-lg text-success fw-bold mt-2"><i class="fa-solid fa-magnifying-glass"></i> Find & Book a Turf</a>
  </div>
</section>

<div class="container my-5">
  <h2 class="mb-4">Featured Turfs</h2>
  <div class="row g-4">
    <% if (turfs.length === 0) { %>
      <p class="text-muted">No turfs available yet. Please check back soon.</p>
    <% } %>
    <% turfs.forEach(turf => { %>
      <div class="col-md-4">
        <div class="card turf-card h-100">
          <img src="<%= turf.image %>" alt="<%= turf.name %>" onerror="this.src='https://placehold.co/600x400?text=Turf'">
          <div class="card-body">
            <h5 class="card-title"><%= turf.name %></h5>
            <p class="text-muted small mb-1"><i class="fa-solid fa-location-dot"></i> <%= turf.location %></p>
            <p class="mb-2"><span class="badge bg-success-subtle text-success"><%= turf.type %></span> <span class="badge bg-secondary-subtle text-secondary"><%= turf.indoorOutdoor %></span></p>
            <p class="fw-bold text-success">৳<%= turf.pricePerHour %> / hour</p>
            <a href="/turfs/<%= turf.id %>" class="btn btn-success w-100">View & Book</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<% if (tournaments.length) { %>
<div class="container my-5">
  <h2 class="mb-4">Upcoming Tournaments</h2>
  <div class="row g-3">
    <% tournaments.forEach(tour => { %>
      <div class="col-md-4">
        <div class="card p-3">
          <h5><%= tour.name %></h5>
          <p class="text-muted small mb-1"><%= tour.sport %> &middot; <%= tour.startDate %></p>
          <a href="/tournaments/<%= tour.id %>" class="btn btn-outline-success btn-sm">Details</a>
        </div>
      </div>
    <% }) %>
  </div>
</div>
<% } %>
