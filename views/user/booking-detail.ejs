<style>
  .tk-wrap { max-width: 760px; }
  .tk-page-bg {
    background: #000;
    border-radius: 18px;
    padding: 34px 20px;
  }
  .ticket {
    display: flex;
    position: relative;
    filter: drop-shadow(0 14px 26px rgba(0,0,0,0.35));
  }
  .tk-main, .tk-stub {
    background: #f2e6c9;
    position: relative;
  }
  .tk-main {
    flex: 1 1 auto;
    min-width: 0;
    border-top-left-radius: 14px;
    border-bottom-left-radius: 14px;
  }
  .tk-stub {
    flex: 0 0 200px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
  }
  .tk-header {
    background: #c1502e;
    color: #fff;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 800;
    letter-spacing: 1px;
    font-size: 0.85rem;
    text-transform: uppercase;
  }
  .tk-main .tk-header { border-top-left-radius: 14px; }
  .tk-stub .tk-header { border-top-right-radius: 14px; justify-content: center; }
  .tk-ref-pill {
    background: #fff;
    color: #c1502e;
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 1px;
    padding: 4px 14px;
    border-radius: 999px;
  }
  .tk-body { padding: 18px 20px 6px; position: relative; }
  .tk-watermark {
    position: absolute;
    right: 10px;
    bottom: 10px;
    font-size: 5.5rem;
    color: rgba(193,80,46,0.08);
    pointer-events: none;
  }
  .tk-row { display: flex; gap: 28px; flex-wrap: wrap; margin-bottom: 14px; }
  .tk-label {
    font-size: 0.65rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #8a6d4a;
    font-weight: 700;
    margin-bottom: 3px;
  }
  .tk-value {
    font-size: 1rem;
    font-weight: 800;
    color: #3b2a1e;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .tk-value.small { font-size: 0.82rem; }
  .tk-mid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 6px 20px 14px;
  }
  .tk-mini-info { display: flex; gap: 22px; }
  .tk-qr-box img { width: 84px; height: 84px; display: block; }
  .tk-bottom-strip {
    display: flex;
    border-top: 1.5px dashed #c9b48a;
  }
  .tk-cell {
    flex: 1;
    padding: 10px 12px;
    border-right: 1.5px dashed #c9b48a;
  }
  .tk-cell:last-child { border-right: none; }
  .tk-cell.price {
    background: #c1502e;
    color: #fff;
    border-bottom-left-radius: 0;
  }
  .tk-cell.price .tk-label { color: rgba(255,255,255,0.85); }
  .tk-cell.price .tk-value { color: #fff; }
  .tk-main .tk-cell:last-of-type.price { border-bottom-left-radius: 0; }

  .tk-divider {
    width: 0;
    border-left: 3px dashed #c1502e;
    position: relative;
    z-index: 2;
  }
  .tk-notch {
    position: absolute;
    width: 26px;
    height: 26px;
    background: #000;
    border-radius: 50%;
    left: -13px;
    z-index: 3;
  }
  .tk-notch.top { top: -13px; }
  .tk-notch.bottom { bottom: -13px; }

  .tk-stub .tk-body { padding: 16px 16px 4px; }
  .tk-stub .tk-row { gap: 14px; margin-bottom: 10px; }
  .tk-stub .tk-value { font-size: 0.85rem; }
  .tk-stub .tk-bottom-strip .tk-cell { padding: 8px; }
  .tk-stub .tk-label { font-size: 0.58rem; }

  @media (max-width: 620px) {
    .ticket { flex-direction: column; }
    .tk-main, .tk-stub { border-radius: 0; }
    .tk-main { border-radius: 14px 14px 0 0; }
    .tk-stub { border-radius: 0 0 14px 14px; }
    .tk-divider { display: none; }
    .tk-mid { flex-direction: column; align-items: flex-start; }
  }

  .tk-status-note { max-width: 760px; }
</style>

<div class="container my-5 tk-wrap">

  <div class="tk-page-bg">
    <div class="ticket">
      <div class="tk-main">
        <div class="tk-header">
          <span>Football Ticket</span>
          <span class="tk-ref-pill">TKT <%= booking.bookingRef %></span>
        </div>
        <div class="tk-body">
          <i class="fa-solid fa-futbol tk-watermark"></i>
          <div class="tk-row">
            <div>
              <div class="tk-label">Player Name</div>
              <div class="tk-value"><%= currentUser.name %></div>
            </div>
            <div>
              <div class="tk-label">Booking Status</div>
              <div class="tk-value"><%= booking.status %></div>
            </div>
          </div>
          <div class="tk-row">
            <div>
              <div class="tk-label">Turf:</div>
              <div class="tk-value"><%= booking.Turf.name %></div>
            </div>
            <div>
              <div class="tk-label">Time:</div>
              <div class="tk-value"><%= booking.startTime %> - <%= booking.endTime %></div>
            </div>
          </div>
        </div>
        <div class="tk-mid">
          <div class="tk-mini-info">
            <div>
              <div class="tk-label">Date</div>
              <div class="tk-value small"><%= booking.date %></div>
            </div>
            <div>
              <div class="tk-label">Type</div>
              <div class="tk-value small"><%= booking.Turf.type %></div>
            </div>
            <div>
              <div class="tk-label">Ref</div>
              <div class="tk-value small"><%= booking.bookingRef %></div>
            </div>
          </div>
          <% if (booking.qrCode) { %>
            <div class="tk-qr-box"><img src="<%= booking.qrCode %>" alt="QR Code"></div>
          <% } %>
        </div>
        <div class="tk-bottom-strip">
          <div class="tk-cell">
            <div class="tk-label">Date</div>
            <div class="tk-value small"><%= booking.date %></div>
          </div>
          <div class="tk-cell">
            <div class="tk-label">Start</div>
            <div class="tk-value small"><%= booking.startTime %></div>
          </div>
          <div class="tk-cell">
            <div class="tk-label">End</div>
            <div class="tk-value small"><%= booking.endTime %></div>
          </div>
          <div class="tk-cell price">
            <div class="tk-label">Price</div>
            <div class="tk-value small">৳<%= booking.totalPrice %></div>
          </div>
        </div>
      </div>

      <div class="tk-divider">
        <div class="tk-notch top"></div>
        <div class="tk-notch bottom"></div>
      </div>

      <div class="tk-stub">
        <div class="tk-header"><span>Football Ticket</span></div>
        <div class="tk-body">
          <div class="tk-row">
            <div>
              <div class="tk-label">Player Name</div>
              <div class="tk-value"><%= currentUser.name %></div>
            </div>
          </div>
          <div class="tk-row">
            <div>
              <div class="tk-label">Turf:</div>
              <div class="tk-value"><%= booking.Turf.name %></div>
            </div>
          </div>
          <div class="tk-row">
            <div>
              <div class="tk-label">Time:</div>
              <div class="tk-value"><%= booking.startTime %> - <%= booking.endTime %></div>
            </div>
          </div>
        </div>
        <div class="tk-bottom-strip">
          <div class="tk-cell">
            <div class="tk-label">Date</div>
            <div class="tk-value small"><%= booking.date %></div>
          </div>
          <div class="tk-cell">
            <div class="tk-label">Type</div>
            <div class="tk-value small"><%= booking.Turf.type %></div>
          </div>
          <div class="tk-cell">
            <div class="tk-label">Ref</div>
            <div class="tk-value small"><%= booking.bookingRef %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <button type="button" id="downloadTicketBtn" class="btn btn-dark w-100 mt-3">
    <i class="fa-solid fa-download me-1"></i> Download Ticket
  </button>

  <!-- Supplementary details below the ticket visual -->
  <div class="card p-4 mt-4 shadow-sm tk-status-note">
    <% const steps = ['pending', 'confirmed', 'completed']; const curIdx = steps.indexOf(booking.status); %>
    <% if (booking.status === 'cancelled') { %>
      <div class="alert alert-secondary py-2 mb-3">This booking was cancelled.</div>
    <% } else { %>
      <div class="d-flex justify-content-between mb-4 small text-center">
        <% ['Booked', 'Payment Verified', 'Completed'].forEach((label, i) => { %>
          <div class="flex-fill">
            <div class="mx-auto rounded-circle d-flex align-items-center justify-content-center mb-1"
                 style="width:28px;height:28px;background:<%= i <= curIdx ? '#198754' : '#dee2e6' %>;color:#fff;">
              <%- i < curIdx ? '&#10003;' : (i+1) %>
            </div>
            <div class="<%= i <= curIdx ? 'text-success fw-bold' : 'text-muted' %>"><%= label %></div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (booking.discountAmount > 0) { %><p><strong>Discount:</strong> -৳<%= booking.discountAmount %> (<%= booking.couponCode %>)</p><% } %>
    <% if (booking.Payment) { %>
      <p><strong>Payment Method:</strong> <%= booking.Payment.method %></p>
      <p><strong>Payment Status:</strong> <%= booking.Payment.status %></p>
      <p><strong>Invoice No:</strong> <%= booking.Payment.invoiceNo %></p>
      <p><strong>Transaction ID:</strong> <%= booking.Payment.transactionId || '-' %></p>
      <p><strong>Payer Name:</strong> <%= booking.Payment.payerName || '-' %></p>
      <p><strong>Payer Number:</strong> <%= booking.Payment.payerNumber || '-' %></p>
    <% } %>
    <% if (booking.notes) { %><p class="mb-0"><strong>Notes:</strong> <%= booking.notes %></p><% } %>
  </div>

  <a href="/my-bookings" class="btn btn-outline-success w-100 mt-3"><i class="fa-solid fa-arrow-left me-1"></i> Back to My Bookings</a>
</div>

<% if (booking.Payment && booking.Payment.status === 'pending' && ['bKash','Nagad','Rocket'].includes(booking.Payment.method) && booking.status !== 'confirmed') { %>
  <div class="container mt-3 tk-wrap">
    <div class="card p-3">
      <h5>Submit Payment Details</h5>
      <p class="text-muted small">Send the amount to admin number: <strong><%= settings.contactPhone %></strong> and enter the transaction details below for verification.</p>
      <form action="/my-bookings/<%= booking.id %>/payment" method="POST">
        <div class="mb-2"><label class="form-label">Transaction ID</label><input type="text" name="transactionId" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Payer Name</label><input type="text" name="payerName" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Payer Number</label><input type="text" name="payerNumber" class="form-control" required></div>
        <button class="btn btn-success">Submit for Verification</button>
      </form>
    </div>
  </div>
<% } %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
(function () {
  const btn = document.getElementById('downloadTicketBtn');
  if (!btn) return;
  btn.addEventListener('click', function () {
    const ticket = document.querySelector('.tk-page-bg');
    if (!ticket || typeof html2canvas === 'undefined') return;
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = 'Preparing image...';
    html2canvas(ticket, { backgroundColor: '#000', scale: 2 }).then(function (canvas) {
      const link = document.createElement('a');
      link.download = 'ticket-<%= booking.bookingRef %>.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
      btn.disabled = false;
      btn.innerHTML = originalText;
    }).catch(function () {
      btn.disabled = false;
      btn.innerHTML = originalText;
      alert('Could not generate the ticket image. Please try again.');
    });
  });
})();
</script>
