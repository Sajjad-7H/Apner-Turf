<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= settings.siteName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <%
    const themePrimary = settings.primaryColor || '#14a34a';
    const themeSecondary = settings.secondaryColor || '#0d6e2f';
    const themePrimaryRgb = typeof hexToRgb === 'function' ? hexToRgb(themePrimary) : '20,163,74';
  %>
  <!-- Site-wide color theme, set by the admin in Settings -> Website Colors -->
  <style>
    :root {
      --bs-success: <%= themePrimary %>;
      --bs-success-rgb: <%= themePrimaryRgb %>;
    }
    .btn-success { background-color: <%= themePrimary %> !important; border-color: <%= themePrimary %> !important; }
    .btn-success:hover, .btn-success:focus { filter: brightness(0.92); }
    .btn-outline-success { color: <%= themePrimary %> !important; border-color: <%= themePrimary %> !important; }
    .btn-outline-success:hover { background-color: <%= themePrimary %> !important; color: #fff !important; }
    .text-success { color: <%= themePrimary %> !important; }
    .hero { background: linear-gradient(135deg, <%= themeSecondary %>, <%= themePrimary %>) !important; }
    .sidebar a.active, .sidebar a:hover { background: <%= themePrimary %> !important; }
  </style>
</head>
<body class="<%= ['Login', 'Register'].includes(title) ? 'auth-page' : '' %>">
  <%- include('navbar') %>

  <% if (success && success.length) { %>
    <div class="container mt-3">
      <% success.forEach(msg => { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }) %>
    </div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="container mt-3">
      <% error.forEach(msg => { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }) %>
    </div>
  <% } %>

  <main>
    <%- body %>
  </main>

  <%- include('footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
